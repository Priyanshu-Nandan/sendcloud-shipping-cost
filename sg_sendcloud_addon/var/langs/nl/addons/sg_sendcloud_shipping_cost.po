msgctxt "Addons::name::sg_sendcloud_shipping_cost"
msgid "SendCloud Shipping Cost"
msgstr "SendCloud Verzendkosten"

msgctxt "Addons::description::sg_sendcloud_shipping_cost"
msgid "Integration with SendCloud shipping service for calculating shipping costs"
msgstr "Integratie met SendCloud verzendservice voor het berekenen van verzendkosten"

msgctxt "SettingsSections::sg_sendcloud_shipping_cost::general"
msgid "General"
msgstr "Algemeen"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::public_api_key"
msgid "Public API Key"
msgstr "Openbare API-sleutel"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::public_api_key"
msgid "Enter your SendCloud public API key"
msgstr "Voer uw openbare SendCloud API-sleutel in"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::secret_api_key"
msgid "Secret API Key"
msgstr "Geheime API-sleutel"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::secret_api_key"
msgid "Enter your SendCloud secret API key"
msgstr "Voer uw geheime SendCloud API-sleutel in"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::brand_id"
msgid "Brand ID"
msgstr "Merk-ID"

msgctxt "SettingsOptions::sg_sendcloud_shipping_cost::brand_id"
msgid "Enter your SendCloud brand ID"
msgstr "Voer uw SendCloud Merk-ID in"

msgctxt "Languages::sg_sendcloud_shipping_cost"
msgid "SendCloud Shipping Cost"
msgstr "SendCloud Verzendkosten"

msgctxt "Languages::carrier_sendcloud_two"
msgid "SendCloud2"
msgstr "SendCloud2"

msgctxt "Languages::carrier_sendcloud"
msgid "SendCloud2"
msgstr "SendCloud2"

msgctxt "Languages::sg_sendcloud_shipping_cost.public_api_key_placeholder"
msgid "e.g., pk_live_xxxxxxxxxxxxxx"
msgstr "bijv. pk_live_xxxxxxxxxxxxxx"

msgctxt "Languages::sg_sendcloud_shipping_cost.secret_api_key_placeholder"
msgid "e.g., sk_live_xxxxxxxxxxxxxx"
msgstr "bijv. sk_live_xxxxxxxxxxxxxx"

msgctxt "Languages::sg_sendcloud_shipping_cost.brand_id_placeholder"
msgid "e.g., 123456"
msgstr "bijv. 123456"

msgctxt "Languages::sg_sendcloud_shipping_cost.test_connection"
msgid "Test Connection"
msgstr "Verbinding testen"

msgctxt "Languages::sg_sendcloud_shipping_cost.surcharge_amount"
msgid "Surcharge Amount"
msgstr "Bijdragebedrag"

msgctxt "Languages::sg_sendcloud_shipping_cost.surcharge_amount_description"
msgid "Additional charge to add to the calculated shipping cost (in base currency)"
msgstr "Aanvullende kosten die moeten worden toegevoegd aan de berekende verzendkosten (in basisvaluta)"

msgctxt "Languages::sg_sendcloud_shipping_cost.default_weight"
msgid "Default Weight"
msgstr "Standaardgewicht"

msgctxt "Languages::sg_sendcloud_shipping_cost.default_weight_description"
msgid "Default weight to use when order weight is not available (in kilograms)"
msgstr "Standaardgewicht dat wordt gebruikt wanneer het bestelgewicht niet beschikbaar is (in kilogram)"

msgctxt "Languages::sg_sendcloud_shipping_cost.rates_note"
msgid "Shipping rates will be calculated from SendCloud API based on order weight and destination."
msgstr "Verzendtarieven worden berekend via SendCloud API op basis van bestelgewicht en bestemming."

msgctxt "Languages::sg_sendcloud_shipping_cost.error_missing_credentials"
msgid "Missing SendCloud API credentials. Please configure your API keys and brand ID in addon settings."
msgstr "SendCloud API-inloggegevens ontbreken. Configureer uw API-sleutels en Merk-ID in de add-on instellingen."

msgctxt "Languages::sg_sendcloud_shipping_cost.error_invalid_credentials"
msgid "Invalid SendCloud API credentials. Please verify your API keys and brand ID."
msgstr "Ongeldige SendCloud API-inloggegevens. Controleer uw API-sleutels en Merk-ID."

msgctxt "Languages::sg_sendcloud_shipping_cost.error_api_error"
msgid "SendCloud API error occurred. Please try again later."
msgstr "Er is een SendCloud API-fout opgetreden. Probeer het later opnieuw."

msgctxt "Languages::sg_sendcloud_shipping_cost.error_network_error"
msgid "Network error connecting to SendCloud. Please check your internet connection."
msgstr "Netwerkfout bij verbinding met SendCloud. Controleer uw internetverbinding."

msgctxt "Languages::sg_sendcloud_shipping_cost.success_settings_saved"
msgid "SendCloud settings have been saved successfully."
msgstr "SendCloud-instellingen zijn succesvol opgeslagen."

msgctxt "Languages::sg_sendcloud_shipping_cost.success_connection_tested"
msgid "SendCloud API connection verified successfully."
msgstr "SendCloud API-verbinding succesvol geverifieerd."

msgctxt "Languages::sg_sendcloud_shipping_cost.error_no_dhl_method"
msgid "No DHL shipping method available for this destination"
msgstr "Geen DHL verzendmethode beschikbaar voor deze bestemming"

msgctxt "Languages::sg_sendcloud_shipping_cost.shipping_method"
msgid "Sendcloud Shipping Method"
msgstr "SendCloud verzendmethode"

msgctxt "Languages::sg_sendcloud_shipping_cost.shipping_method_description"
msgid "Sendcloud Shipping Method"
msgstr "SendCloud verzendmethode"

msgctxt "Languages::sendcloud_shipping_error"
msgid "Error! please check the country, postal code, and weight"
msgstr "Fout! Controleer alstublieft het land, postcode en gewicht"

msgctxt "Languages::sg_sendcloud_shipping_cost.select_method"
msgid "Select a Sendcloud Shipping Method"
msgstr "Selecteer een SendCloud verzendmethode"

msgctxt "Languages::sg_sendcloud_shipping_cost.no_credentials"
msgid "Missing Sendcloud API credentials"
msgstr "SendCloud API-inloggegevens ontbreken"